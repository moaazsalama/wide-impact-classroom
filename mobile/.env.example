# Copy to `.env` (or `.env.local`) and adjust. EXPO_PUBLIC_* values are inlined into the JS bundle.

# Backend base URL (without /api/v1).
#   Android emulator -> http://10.0.2.2:4000
#   iOS simulator    -> http://localhost:4000
#   Physical device  -> http://<your-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Google OAuth "Web application" client ID. Required on Android to obtain an ID token
# (must be listed in the backend's GOOGLE_CLIENT_IDS). Leave empty to disable Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google OAuth iOS client ID (optional, iOS only). The iOS URL scheme for the native
# config plugin is derived from it at prebuild time.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# "true" shows the one-tap test accounts on the sign-in screen (backend needs ENABLE_DEV_LOGIN=true).
EXPO_PUBLIC_ENABLE_DEV_LOGIN=true

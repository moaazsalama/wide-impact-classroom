NODE_ENV=development
PORT=4000
# Local: postgres://user@localhost:5432/wide_impact  | Neon: postgres://...?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wide_impact
DATABASE_SSL=false
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated OAuth client IDs accepted as ID-token audience (web, iOS, Android)
GOOGLE_CLIENT_IDS=
# Enables POST /api/v1/auth/dev-login (reviewer test accounts). Keep false unless needed.
ENABLE_DEV_LOGIN=false
CORS_ORIGINS=*
LOG_LEVEL=info
# Reverse-proxy hops to trust for client IP (1 on Render)
TRUST_PROXY=0
